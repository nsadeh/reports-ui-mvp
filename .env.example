# Anthropic API key. If absent, the chat falls back to qa-fallback.json pairs.
ANTHROPIC_API_KEY=

# Password gate (middleware.ts). Both are required in production.
# - INTERNAL: full access to all reports, dashboard, commission page.
# - CUSTOMER: scoped to a single report and the chat API only.
SHARED_PASSWORD_INTERNAL=
SHARED_PASSWORD_CUSTOMER=

# Comma-separated list of report slugs the customer is allowed to view
# (each must match a directory name under data/reports/).
# The first entry is the customer's landing page after login.
# Example: tnf-alpha-landscape-2026-03-10,alzheimer-landscape-2026-03-31
CUSTOMER_REPORT_IDS=
